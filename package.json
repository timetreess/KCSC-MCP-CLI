{
  "name": "kcsc-standards-mcp",
  "version": "1.0.0",
  "description": "KCSC Standards MCP/CLI for retrieving verifiable Korean construction standards evidence.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "bin": {
    "kcsc": "./dist/src/cli/index.js",
    "kcsc-mcp": "./dist/src/mcp/server.js"
  },
  "files": [
    "dist/src",
    "!dist/src/**/*.map",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "author": "timetreess",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timetreess/kds.git"
  },
  "homepage": "https://github.com/timetreess/kds#readme",
  "bugs": {
    "url": "https://github.com/timetreess/kds/issues"
  },
  "keywords": [
    "kcsc",
    "kds",
    "kcs",
    "construction-standards",
    "korean-construction",
    "mcp",
    "modelcontextprotocol",
    "cli",
    "standards"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:cli": "tsx src/cli/index.ts",
    "dev:mcp": "tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=20"
  }
}
